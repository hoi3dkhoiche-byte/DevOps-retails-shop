  search_admin = "arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:/retail/platform/search/admin-REPLACE"
  redis_dev   = "arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:/retail/platform/redis/dev-REPLACE"
  redis_prod  = "arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:/retail/platform/redis/prod-REPLACE"
