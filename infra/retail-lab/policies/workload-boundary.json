{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegionalControllerRuntime",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:GetCoipPoolUsage",
        "ec2:GetSecurityGroupsForVpc",
        "ec2:GetInstanceTypesFromInstanceRequirements",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:CreateVolume",
        "ec2:DeleteVolume",
        "ec2:ModifyVolume",
        "ec2:CreateSnapshot",
        "ec2:DeleteSnapshot",
        "ec2:EnableFastSnapshotRestores",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:CreateRoute",
        "ec2:DeleteRoute",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:ModifyInstanceAttribute",
        "ec2:CreateNetworkInterface",
        "ec2:DeleteNetworkInterface",
        "ec2:AttachNetworkInterface",
        "ec2:DetachNetworkInterface",
        "ec2:ModifyNetworkInterfaceAttribute",
        "ec2:AssignPrivateIpAddresses",
        "ec2:UnassignPrivateIpAddresses",
        "ec2:AssignIpv6Addresses",
        "ec2:UnassignIpv6Addresses",
        "elasticloadbalancing:*",
        "autoscaling:Describe*",
        "autoscaling:UpdateAutoScalingGroup",
        "autoscaling:SetDesiredCapacity",
        "autoscaling:TerminateInstanceInAutoScalingGroup",
        "cloudwatch:Get*",
        "cloudwatch:List*",
        "cloudwatch:DescribeAlarms",
        "ec2messages:*",
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel",
        "ssm:DescribeAssociation",
        "ssm:ListAssociations",
        "ssm:ListInstanceAssociations",
        "ssm:UpdateAssociationStatus",
        "ssm:UpdateInstanceAssociationStatus",
        "ssm:UpdateInstanceInformation",
        "ssm:GetDocument",
        "ssm:DescribeDocument",
        "ssm:GetManifest",
        "ssm:GetDeployablePatchSnapshotForInstance",
        "ssm:PutInventory",
        "ssm:PutComplianceItems",
        "ssm:PutConfigurePackageResult",
        "ecr:GetAuthorizationToken",
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage",
        "eks:DescribeCluster",
        "eks:DescribeNodegroup",
        "tag:GetResources",
        "rds:DescribeDBInstances",
        "elasticache:DescribeCacheClusters",
        "elasticache:DescribeReplicationGroups",
        "elasticache:DescribeUsers",
        "acm:ListCertificates",
        "acm:DescribeCertificate",
        "cognito-idp:DescribeUserPoolClient",
        "shield:GetSubscriptionState",
        "shield:DescribeProtection",
        "shield:CreateProtection",
        "shield:DeleteProtection",
        "waf-regional:GetWebACL",
        "waf-regional:GetWebACLForResource",
        "waf-regional:AssociateWebACL",
        "waf-regional:DisassociateWebACL",
        "wafv2:GetWebACL",
        "wafv2:GetWebACLForResource",
        "wafv2:AssociateWebACL",
        "wafv2:DisassociateWebACL",
        "kms:DescribeKey",
        "ec2:CreateNetworkInterfacePermission",
        "ec2:CopyVolumes"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "__AWS_REGION__"
        }
      }
    },
    {
      "Sid": "ProjectSecretValues",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecretVersionStage"
      ],
      "Resource": [
        "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:/retail/*"
      ]
    },
    {
      "Sid": "BootstrapRdsMaster",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": [
        "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:rds!db-*"
      ]
    },
    {
      "Sid": "CheckoutRedisRotation",
      "Effect": "Allow",
      "Action": [
        "elasticache:ModifyUser"
      ],
      "Resource": [
        "arn:aws:elasticache:__AWS_REGION__:__AWS_ACCOUNT_ID__:user:retail-checkout-dev",
        "arn:aws:elasticache:__AWS_REGION__:__AWS_ACCOUNT_ID__:user:retail-checkout-prod"
      ]
    },
    {
      "Sid": "ProjectObjectStorage",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::retail-lab-__AWS_ACCOUNT_ID__-logs",
        "arn:aws:s3:::retail-lab-__AWS_ACCOUNT_ID__-logs/*",
        "arn:aws:s3:::retail-lab-__AWS_ACCOUNT_ID__-backup",
        "arn:aws:s3:::retail-lab-__AWS_ACCOUNT_ID__-backup/*"
      ]
    },
    {
      "Sid": "IdentityAndCertificateReads",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity",
        "iam:GetServerCertificate",
        "iam:ListServerCertificates"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ControllerServiceLinkedRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/aws-service-role/elasticloadbalancing.amazonaws.com/*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "elasticloadbalancing.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyIamAdministration",
      "Effect": "Deny",
      "Action": [
        "iam:Add*",
        "iam:Attach*",
        "iam:Delete*",
        "iam:Detach*",
        "iam:Put*",
        "iam:Remove*",
        "iam:Set*",
        "iam:Update*",
        "iam:Tag*",
        "iam:Untag*",
        "iam:Upload*",
        "iam:Enable*",
        "iam:Deactivate*",
        "iam:Resync*",
        "iam:ChangePassword",
        "iam:ResetServiceSpecificCredential",
        "iam:PassRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyIdentityCreationExceptElbServiceRole",
      "Effect": "Deny",
      "Action": [
        "iam:Create*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEqualsIfExists": {
          "iam:AWSServiceName": "elasticloadbalancing.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DenyPrivilegeAndResourcePolicyChanges",
      "Effect": "Deny",
      "Action": [
        "sts:AssumeRole*",
        "sts:GetFederationToken",
        "organizations:*",
        "account:*",
        "eks:CreateAccessEntry",
        "eks:UpdateAccessEntry",
        "eks:DeleteAccessEntry",
        "eks:AssociateAccessPolicy",
        "eks:DisassociateAccessPolicy",
        "eks:CreatePodIdentityAssociation",
        "eks:UpdatePodIdentityAssociation",
        "s3:PutBucketPolicy",
        "s3:DeleteBucketPolicy",
        "s3:PutAccessPointPolicy",
        "s3:PutAccessPointPolicyForObjectLambda",
        "secretsmanager:PutResourcePolicy",
        "secretsmanager:DeleteResourcePolicy",
        "kms:PutKeyPolicy",
        "kms:CreateGrant",
        "ssm:SendCommand",
        "ssm:StartSession",
        "ec2:AssociateIamInstanceProfile",
        "ec2:ReplaceIamInstanceProfileAssociation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyRepositoryTokenOutsideArgoReader",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:PutSecretValue",
        "secretsmanager:UpdateSecretVersionStage"
      ],
      "Resource": "arn:aws:secretsmanager:__AWS_REGION__:__AWS_ACCOUNT_ID__:secret:/retail/platform/argocd/repositories-*",
      "Condition": {
        "ArnNotEquals": {
          "aws:PrincipalArn": "arn:aws:iam::__AWS_ACCOUNT_ID__:role/retail-lab-eso-argocd"
        }
      }
    }
  ]
}
