{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "ci-mysql-init"
      },
      "data": {
        "10-retail.sql": "-- Disposable local/CI fixture only. AWS credentials are bootstrapped out of band.\n-- Let the image entrypoint choose the initialization socket and root credentials.\nCREATE DATABASE IF NOT EXISTS catalog_ci;\nCREATE USER IF NOT EXISTS 'catalog_user'@'%' IDENTIFIED BY 'ci-only-password';\nGRANT ALL PRIVILEGES ON catalog_ci.* TO 'catalog_user'@'%';\n\nCREATE DATABASE IF NOT EXISTS cart_ci;\nCREATE USER IF NOT EXISTS 'cart_user'@'%' IDENTIFIED BY 'ci-only-password';\nGRANT ALL PRIVILEGES ON cart_ci.* TO 'cart_user'@'%';\n\nCREATE DATABASE IF NOT EXISTS orders_ci;\nCREATE USER IF NOT EXISTS 'orders_user'@'%' IDENTIFIED BY 'ci-only-password';\nGRANT ALL PRIVILEGES ON orders_ci.* TO 'orders_user'@'%';\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "mysql"
      },
      "spec": {
        "selector": {
          "app": "ci-mysql"
        },
        "ports": [
          {
            "port": 3306
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "mysql"
      },
      "spec": {
        "serviceName": "mysql",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "ci-mysql"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "ci-mysql"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "mysql",
                "image": "mysql:8.4.11",
                "env": [
                  {
                    "name": "MYSQL_ROOT_PASSWORD",
                    "value": "ci-only-root-password"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 3306
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "memory": "1Gi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "init",
                    "mountPath": "/docker-entrypoint-initdb.d"
                  },
                  {
                    "name": "data",
                    "mountPath": "/var/lib/mysql"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "export MYSQL_PWD=ci-only-password; for service in catalog cart orders; do mysql -h127.0.0.1 -u${service}_user ${service}_ci -e \"SELECT 1\" || exit 1; done"
                    ]
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                },
                "args": ["--socket=/var/lib/mysql/ci-fixture.sock"]
              }
            ],
            "volumes": [
              {
                "name": "init",
                "configMap": {
                  "name": "ci-mysql-init"
                }
              },
              {
                "name": "data",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    }
  ]
}
