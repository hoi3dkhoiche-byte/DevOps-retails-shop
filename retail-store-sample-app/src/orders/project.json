{
  "name": "orders",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "src/orders",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "java --version"
        }
      ],
      "outputs": ["{projectRoot}/target/*.jar"],
      "options": {
        "command": "bash ./mvnw --batch-mode --no-transfer-progress -DskipTests package"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{projectRoot}/target/surefire-reports"],
      "options": {
        "command": "bash ./mvnw --batch-mode --no-transfer-progress test -DexcludedGroups=integration -DfailIfNoTests=true"
      }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "inputs": ["default"],
      "outputs": ["{projectRoot}/target/surefire-reports"],
      "options": {
        "command": "bash ./mvnw --batch-mode --no-transfer-progress test -Dgroups=integration -DfailIfNoTests=true"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "bash ./mvnw --batch-mode --no-transfer-progress checkstyle:checkstyle"
      },
      "cache": false
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./mvnw spring-boot:run"
      }
    },
    "manifest": {},
    "helm": {}
  },
  "tags": ["service", "chart"]
}
