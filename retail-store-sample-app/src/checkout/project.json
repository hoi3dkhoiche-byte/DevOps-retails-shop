{
  "name": "checkout",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "src/checkout",
        "command": "yarn install --immutable"
      },
      "cache": false
    },
    "build": {
      "dependsOn": ["install"],
      "cache": true,
      "inputs": [
        "default",
        {
          "runtime": "node --version"
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "dependsOn": [],
      "cache": false
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build"],
      "inputs": ["default"],
      "options": {
        "command": "yarn test:integration --runInBand --json --outputFile=../../reports/ci-native/checkout-integration.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "dependsOn": ["install"],
      "options": {
        "command": "yarn lint"
      },
      "cache": false
    },
    "manifest": {},
    "helm": {}
  },
  "tags": ["service", "chart"]
}
